# Keep real keys in deployment environment variables. Never commit them.
MODEL_PRIMARY_BASE_URL=
MODEL_PRIMARY_API_KEY=
MODEL_PRIMARY_NAME=

# Optional fallback (must use an OpenAI-compatible chat completions API)
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_NAME=

# Optional multi-model list (takes precedence over legacy MODEL_PRIMARY/FALLBACK).
# Store this as one JSON string in Render; keep API keys private.
# Example:
# MODEL_PROVIDERS_JSON=[{"id":"openrouter-free","label":"OpenRouter Free","baseUrl":"https://openrouter.ai/api/v1","apiKey":"YOUR_KEY","model":"openrouter/free"},{"id":"groq-fast","label":"Groq Fast","baseUrl":"https://api.groq.com/openai/v1","apiKey":"YOUR_KEY","model":"YOUR_GROQ_MODEL"}]
MODEL_PROVIDERS_JSON=

# Supabase project settings (use the publishable/anon key, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
