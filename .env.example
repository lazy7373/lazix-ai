# Choose the open-weight model served by the GPU container.
LAZIX_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Long random secret shared only between the two containers.
LAZIX_INFERENCE_TOKEN=replace-with-a-long-random-secret

# Basic authentication for your private LAZIX website.
LAZIX_ACCESS_USER=lazy
LAZIX_ACCESS_PASSWORD=replace-with-a-different-long-password

# Optional Hugging Face token if model download access requires it.
HF_TOKEN=
