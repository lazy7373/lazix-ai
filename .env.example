# Private URL of the GPU machine running LAZIX's own vLLM model server.
# Example: http://YOUR_PRIVATE_GPU_HOST:8000
LAZIX_INFERENCE_URL=

# Must match the model configured on the inference server.
LAZIX_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Optional shared secret. Keep it identical on the GPU server and web app.
LAZIX_INFERENCE_TOKEN=
